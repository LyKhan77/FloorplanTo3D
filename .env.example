# Copy to .env (gitignored). Loaded with: uv run --env-file .env ...
DATA_DIR=./data
# Must be the real binary path; the Homebrew symlink crashes ("Bundled Python not found")
BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
BLENDER_RENDER_DEVICE=CPU
STRATA_BASE_URL=http://192.168.2.142:8081/v1
STRATA_MODEL=qwen3.8-flash-next-iq2_xs
STRATA_TIMEOUT_S=120
# Bearer key when the Strata server requires one (DGX server); never commit the real value
STRATA_API_KEY=
LLM_TASKS_ENABLED=T0,T3
LLM_MAX_ITER=5
LLM_VOTES=3
SWEEP_MAX_CANDIDATES=12
MAX_UPLOAD_MB=50
# WeasyPrint on macOS (pango from Homebrew)
DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib
